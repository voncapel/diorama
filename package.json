{
  "name": "diorama",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome MV3 extension turning a live web page into an animated 3D diorama scene.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:content && npm run build:background",
    "build:studio": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build:background": "DIORAMA_TARGET=background vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "0.539.0",
    "mp4-muxer": "5.2.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.179.1",
    "zustand": "5.0.7"
  },
  "devDependencies": {
    "@types/chrome": "0.0.326",
    "@types/node": "^22.20.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
